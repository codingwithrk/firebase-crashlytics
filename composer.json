{
    "name": "codingwithrk/firebase-crashlytics",
    "description": "A NativePHP Mobile plugin for Firebase Crashlytics. Records fatal and non-fatal errors, breadcrumb logs, user identifiers and custom keys, and reports them to the Firebase console.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "CodingwithRK",
            "email": "pappalarajkumar@gmail.com",
            "homepage": "https://codingwithrk.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Codingwithrk\\FirebaseCrashlytics\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codingwithrk\\FirebaseCrashlytics\\FirebaseCrashlyticsServiceProvider"
            ],
            "aliases": {
                "FirebaseCrashlytics": "Codingwithrk\\FirebaseCrashlytics\\Facades\\FirebaseCrashlytics"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}